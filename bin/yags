#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later

import argparse
import os
import re
import shutil
import subprocess
import sys
import time
import xml.etree.ElementTree as ET
from pathlib import Path

UUID = "yags@ru-dr"
SCHEMA = "org.gnome.shell.extensions.yags"
VERSION = "1.0.0"
REPO = Path(__file__).resolve().parent.parent
EXT_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "gnome-shell/extensions" / UUID
BIN_DIR = Path.home() / ".local/bin"
BOOKMARKS = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "yags" / "bookmarks.json"
BUILTIN_PROVIDERS = {
    "calc": ("yags-calc", "Calculator, units, currency, dev tools  (=)"),
    "apps": ("applications", "Applications and system actions"),
    "bookmarks": ("yags-bookmarks", "yags bookmarks  (*)"),
    "windows": ("yags-windows", "Open windows  (<)"),
    "files": ("yags-files", "File search  (?)"),
    "clipboard": ("yags-clipboard", "Clipboard history  (:)"),
    "shell": ("yags-shell", "Shell commands  (>)"),
    "web": ("yags-web", "Web search and URLs  (??)"),
}
KEYWORDS = [
    ("=", "calculator: 2^10, 0xff | 0b1, 10 km to mi, 50 usd to inr, sqrt(2)"),
    (">", "shell: > pwd shows live output, Enter runs in a terminal"),
    ("<", "switch to an open window"),
    ("?", "files only"),
    ("??", "web search, or a site shortcut like: g, yt, gh, w, maps, so, mdn"),
    ("*", "bookmarks only"),
    (":", "clipboard history"),
]
PAYLOAD = ["extension.js", "metadata.json", "prefs.js", "stylesheet.css", "LICENSE", "lib", "prefs", "schemas"]
SHORTCUT_SCHEMAS = [
    "org.gnome.desktop.wm.keybindings",
    "org.gnome.shell.keybindings",
    "org.gnome.mutter.keybindings",
    "org.gnome.mutter.wayland.keybindings",
    "org.gnome.settings-daemon.plugins.media-keys",
]

TTY = sys.stdout.isatty()


def paint(code, text):
    return f"\033[{code}m{text}\033[0m" if TTY else text


def ok(text):
    print(f"{paint('32', '✔')} {text}")


def warn(text):
    print(f"{paint('33', '!')} {text}")


def bad(text):
    print(f"{paint('31', '✘')} {text}")


def die(text):
    bad(text)
    sys.exit(1)


def run(*cmd, check=False):
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=check)
    except FileNotFoundError:
        return None
    return res


def schema_dir():
    for d in (EXT_DIR / "schemas", REPO / "schemas"):
        if (d / "gschemas.compiled").exists():
            return d
    for d in (EXT_DIR / "schemas", REPO / "schemas"):
        if d.exists():
            run("glib-compile-schemas", str(d))
            if (d / "gschemas.compiled").exists():
                return d
    die("schema not found, run `yags install` first")


def keys():
    d = schema_dir()
    xml = next(d.glob("*.gschema.xml"))
    root = ET.parse(xml).getroot()
    out = {}
    for k in root.iter("key"):
        rng = k.find("range")
        out[k.get("name")] = {
            "type": k.get("type"),
            "summary": (k.findtext("summary") or "").strip(),
            "description": (k.findtext("description") or "").strip(),
            "choices": [c.get("value") for c in k.iter("choice")],
            "range": (int(rng.get("min")), int(rng.get("max"))) if rng is not None else None,
        }
    return out


def gs(*args):
    res = run("gsettings", "--schemadir", str(schema_dir()), *args)
    if res is None:
        die("gsettings not found")
    if res.returncode != 0:
        die(res.stderr.strip() or "gsettings failed")
    return res.stdout.strip()


def gv_string(value):
    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"


def parse_variant(text):
    text = text.strip()
    if text.startswith("@as "):
        text = text[4:]
    if text in ("true", "false"):
        return text == "true"
    if re.fullmatch(r"-?\d+", text):
        return int(text)
    if text.startswith("["):
        return [a or b for a, b in re.findall(r"'((?:[^'\\]|\\.)*)'|\"((?:[^\"\\]|\\.)*)\"", text)]
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "'\"":
        return text[1:-1].replace("\\'", "'").replace('\\"', '"')
    return text


def fmt(value):
    if isinstance(value, bool):
        return paint("32", "on") if value else paint("2", "off")
    if isinstance(value, list):
        return ", ".join(value) if value else paint("2", "(none)")
    return str(value)


def to_variant(key, meta, raw):
    t = meta["type"]
    if t == "b":
        v = raw.lower()
        if v in ("on", "true", "yes", "1", "enable", "enabled"):
            return "true"
        if v in ("off", "false", "no", "0", "disable", "disabled"):
            return "false"
        die(f"{key} expects on or off")
    if t == "i":
        if not re.fullmatch(r"-?\d+", raw):
            die(f"{key} expects a whole number")
        n = int(raw)
        lo, hi = meta["range"] or (None, None)
        if lo is not None and not lo <= n <= hi:
            die(f"{key} must be between {lo} and {hi}")
        return str(n)
    if t == "s":
        if meta["choices"] and raw not in meta["choices"]:
            die(f"{key} must be one of: {', '.join(meta['choices'])}")
        if key == "accent-color" and not re.fullmatch(r"#[0-9a-fA-F]{6}", raw):
            die("accent-color expects #rrggbb, for example #0a84ff")
        return gv_string(raw)
    if t == "as":
        items = [x.strip() for x in raw.split(",") if x.strip()]
        return "[" + ", ".join(gv_string(x) for x in items) + "]"
    die(f"unsupported type {t}")


def get(key):
    return parse_variant(gs("get", SCHEMA, key))


def set_key(key, raw):
    all_keys = keys()
    if key not in all_keys:
        die(f"unknown setting {key}, see `yags list`")
    gs("set", SCHEMA, key, to_variant(key, all_keys[key], raw))
    ok(f"{key} = {fmt(get(key))}")


def ext_state():
    res = run("gnome-extensions", "info", UUID)
    if res is None or res.returncode != 0:
        return None
    m = re.search(r"State:\s*(\S+)", res.stdout)
    return m.group(1) if m else "UNKNOWN"


def cmd_status(_):
    state = ext_state()
    print(paint("1", f"yags {VERSION}") + "  Yet Another GNOME Search")
    if state is None:
        if (EXT_DIR / "metadata.json").exists():
            warn(f"installed in {EXT_DIR}, GNOME loads it at next login")
            print("  log out and back in, then run: yags enable")
        else:
            warn(f"not installed in {EXT_DIR.parent}")
            print("  run `yags install`, then log out and back in")
        return
    link = f" -> {EXT_DIR.resolve()}" if EXT_DIR.is_symlink() else ""
    print(f"  path      {EXT_DIR}{link}")
    colour = "32" if state in ("ACTIVE", "ENABLED") else "33"
    print(f"  state     {paint(colour, state)}")
    print(f"  shortcut  {', '.join(get('toggle-shortcut'))}")
    print(f"  theme     {get('theme-preference')}")
    on = [k[8:] for k in keys() if k.startswith("feature-") and get(k)]
    print(f"  features  {len(on)} on: {', '.join(on)}")
    if state == "INITIALIZED":
        warn("installed but not loaded yet, log out and back in")


def cmd_enable(_):
    res = run("gnome-extensions", "enable", UUID)
    if res is None or res.returncode != 0:
        die((res.stderr.strip() if res else "") or "could not enable, is it installed? log out and back in after installing")
    ok("enabled")


def cmd_disable(_):
    res = run("gnome-extensions", "disable", UUID)
    if res is None or res.returncode != 0:
        die((res.stderr.strip() if res else "") or "could not disable")
    ok("disabled")


def cmd_list(args):
    all_keys = keys()
    width = max(len(k) for k in all_keys)
    for key, meta in all_keys.items():
        if args.features and not key.startswith("feature-"):
            continue
        print(f"  {paint('36', key.ljust(width))}  {fmt(get(key)):<24}  {paint('2', meta['summary'])}")


def cmd_get(args):
    if args.key not in keys():
        die(f"unknown setting {args.key}, see `yags list`")
    print(fmt(get(args.key)))


def cmd_set(args):
    set_key(args.key, " ".join(args.value))


def cmd_reset(args):
    all_keys = keys()
    targets = list(all_keys) if args.all else args.keys
    if not targets:
        die("name a setting or pass --all")
    for key in targets:
        if key not in all_keys:
            die(f"unknown setting {key}")
        gs("reset", SCHEMA, key)
        ok(f"{key} reset to {fmt(get(key))}")


def cmd_feature(args):
    all_keys = keys()
    names = [k[8:] for k in all_keys if k.startswith("feature-")]
    if args.action in (None, "list"):
        width = max(len(n) for n in names)
        for n in names:
            print(f"  {paint('36', n.ljust(width))}  {fmt(get('feature-' + n)):<14}  {paint('2', all_keys['feature-' + n]['summary'])}")
        return
    if not args.names:
        die(f"name a feature: {', '.join(names)}")
    targets = names if args.names == ["all"] else args.names
    for n in targets:
        if n not in names:
            die(f"unknown feature {n}, choose from: {', '.join(names)}")
        set_key("feature-" + n, args.action)


def cmd_theme(args):
    if args.value:
        set_key("theme-preference", args.value)
    else:
        print(get("theme-preference"))


def cmd_shortcut(args):
    if not args.value:
        print(", ".join(get("toggle-shortcut")))
        return
    accel = args.value
    if "<" not in accel:
        parts = accel.split("+")
        mods = {"super": "<Super>", "ctrl": "<Control>", "control": "<Control>", "alt": "<Alt>", "shift": "<Shift>"}
        accel = "".join(mods.get(p.lower(), "") for p in parts[:-1]) + parts[-1].lower()
    gs("set", SCHEMA, "toggle-shortcut", f"[{gv_string(accel)}]")
    ok(f"shortcut = {accel}")
    for where in shortcut_conflicts(accel):
        warn(f"also bound in {where}")


def cmd_accent(args):
    if args.value:
        set_key("accent-color", args.value)
    else:
        print(get("accent-color"))


def cmd_prefs(_):
    res = run("gnome-extensions", "prefs", UUID)
    if res is None or res.returncode != 0:
        die("could not open preferences, is the extension loaded?")


def norm_accel(accel):
    return accel.lower().replace("<primary>", "<control>").replace("<ctrl>", "<control>")


def shortcut_conflicts(accel):
    want = norm_accel(accel)
    found = []
    for schema in SHORTCUT_SCHEMAS:
        res = run("gsettings", "list-recursively", schema)
        if not res or res.returncode != 0:
            continue
        for line in res.stdout.splitlines():
            parts = line.split(" ", 2)
            if len(parts) == 3 and any(norm_accel(v) == want for v in re.findall(r"'([^']*)'", parts[2])):
                found.append(f"{parts[0]} {parts[1]}")
    return found


def cmd_doctor(_):
    print(paint("1", "yags doctor"))
    state = ext_state()
    if state is None and (EXT_DIR / "metadata.json").exists():
        warn("installed, log out and back in to load it, then: yags enable")
    elif state is None:
        bad("extension not installed, run `yags install`")
    elif state in ("ACTIVE", "ENABLED"):
        ok(f"extension {state.lower()}")
    else:
        warn(f"extension state {state}, log out and back in, then `yags enable`")

    if ext_state_of("spotlight@nin") in ("ACTIVE", "ENABLED"):
        warn("the old spotlight@nin extension is also enabled, turn it off: gnome-extensions disable spotlight@nin")

    plocate = shutil.which("plocate")
    db = Path("/var/lib/plocate/plocate.db")
    if not plocate:
        bad("plocate missing, file search falls back to recent files only (sudo dnf install plocate)")
    elif db.exists():
        age = (time.time() - db.stat().st_mtime) / 3600
        (ok if age < 36 else warn)(f"plocate index updated {age:.0f} h ago")
    else:
        warn("plocate index not built yet, run: sudo updatedb")

    if ext_state_of("copyous@boerdereinar.dev") in ("ACTIVE", "ENABLED"):
        ok("clipboard manager found, clipboard filter available")
    else:
        warn("no supported clipboard manager enabled, clipboard filter hidden")

    jp = run("dconf", "read", "/org/gnome/shell/extensions/just-perfection/search")
    if jp and jp.stdout.strip() == "false":
        warn("Just Perfection hides the Overview search, which breaks it on startup. Fix: dconf write /org/gnome/shell/extensions/just-perfection/search true")

    for accel in get("toggle-shortcut"):
        conflicts = shortcut_conflicts(accel)
        if conflicts:
            for where in conflicts:
                warn(f"{accel} is also bound in {where}")
        else:
            ok(f"{accel} has no conflicts")


def ext_state_of(uuid):
    res = run("gnome-extensions", "info", uuid)
    if res is None or res.returncode != 0:
        return None
    m = re.search(r"State:\s*(\S+)", res.stdout)
    return m.group(1) if m else None


def remote_providers():
    found = {}
    dirs = [Path("/usr/share/gnome-shell/search-providers"),
            Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "gnome-shell/search-providers"]
    for d in dirs:
        for ini in sorted(d.glob("*.ini")) if d.exists() else []:
            m = re.search(r"^DesktopId=(.+)$", ini.read_text(errors="ignore"), re.M)
            if not m:
                continue
            desktop = m.group(1).strip()
            alias = desktop.removesuffix(".desktop").split(".")[-1].lower()
            found[alias] = desktop
    return found


def all_providers():
    out = {k: (v[0], v[1]) for k, v in BUILTIN_PROVIDERS.items()}
    for alias, desktop in remote_providers().items():
        key = alias if alias not in out else desktop.removesuffix(".desktop").lower()
        out[key] = (desktop, desktop.removesuffix(".desktop"))
    return out


def gnome_disabled():
    res = run("gsettings", "get", "org.gnome.desktop.search-providers", "disabled")
    return parse_variant(res.stdout) if res and res.returncode == 0 else []


def cmd_provider(args):
    providers = all_providers()
    disabled = set(get("disabled-providers"))
    gdisabled = set(gnome_disabled())
    if args.action in (None, "list"):
        width = max(len(k) for k in providers)
        for alias, (pid, label) in providers.items():
            if pid in gdisabled:
                state = paint("2", "off (GNOME)")
            else:
                state = fmt(pid not in disabled)
            print(f"  {paint('36', alias.ljust(width))}  {state:<22}  {paint('2', label)}")
        return
    if not args.names:
        die(f"name a source: {', '.join(providers)}")
    targets = list(providers) if args.names == ["all"] else args.names
    for name in targets:
        if name not in providers:
            die(f"unknown source {name}, see `yags provider`")
        pid = providers[name][0]
        if args.action == "off":
            disabled.add(pid)
        else:
            disabled.discard(pid)
            if pid in gdisabled:
                gdisabled.discard(pid)
                run("gsettings", "set", "org.gnome.desktop.search-providers", "disabled",
                    "[" + ", ".join(gv_string(x) for x in sorted(gdisabled)) + "]")
                warn(f"{name} was also off in GNOME Settings, turned that on too")
        ok(f"{name} {'off' if args.action == 'off' else 'on'}")
    gs("set", SCHEMA, "disabled-providers", "[" + ", ".join(gv_string(x) for x in sorted(disabled)) + "]")


def load_bookmarks():
    try:
        import json
        data = json.loads(BOOKMARKS.read_text())
        return data if isinstance(data, list) else []
    except (OSError, ValueError):
        return []


def save_bookmarks(items):
    import json
    BOOKMARKS.parent.mkdir(parents=True, exist_ok=True)
    tmp = BOOKMARKS.with_suffix(".tmp")
    tmp.write_text(json.dumps(items, indent=2, ensure_ascii=False) + "\n")
    tmp.replace(BOOKMARKS)


def bookmark_type(target):
    if target.startswith(">"):
        return "command"
    if re.match(r"^https?://", target, re.I) or re.match(r"^(www\.)?[\w-]+(\.[\w-]+)+(/\S*)?$", target) and not Path(target).expanduser().exists():
        return "site"
    if re.match(r"^[a-z][a-z0-9+.-]*://", target, re.I) and not target.startswith("file://"):
        return "location"
    return "folder" if Path(target.removeprefix("file://")).expanduser().is_dir() else "file"


def cmd_bookmark(args):
    items = load_bookmarks()
    if args.action in (None, "list"):
        if not items:
            print("  no bookmarks yet, add one: yags bookmark add docs ~/Documents")
            return
        width = max(len(b["name"]) for b in items)
        for b in items:
            kind = b.get("type") or bookmark_type(b["target"])
            print(f"  {paint('36', b['name'].ljust(width))}  {kind:<9}  {b['target']}")
        return
    if args.action == "add":
        if len(args.rest) < 2:
            die("usage: yags bookmark add NAME TARGET   (TARGET: a path, URL, sftp://…, or '> command')")
        name, target = args.rest[0], " ".join(args.rest[1:])
        if not target.startswith(">") and not re.match(r"^[a-z][a-z0-9+.-]*://", target, re.I):
            p = Path(target).expanduser()
            if p.exists():
                target = str(p.resolve()).replace(str(Path.home()), "~", 1)
        kind = args.type or bookmark_type(target)
        items = [b for b in items if b["name"] != name]
        entry = {"name": name, "target": target, "type": kind}
        if args.tag:
            entry["tags"] = args.tag
        items.append(entry)
        save_bookmarks(items)
        ok(f"bookmarked {name} ({kind}) -> {target}")
        return
    if args.action in ("rm", "remove"):
        if not args.rest:
            die("usage: yags bookmark rm NAME")
        left = [b for b in items if b["name"] not in args.rest]
        if len(left) == len(items):
            die("no bookmark with that name")
        save_bookmarks(left)
        ok(f"removed {', '.join(args.rest)}")
        return
    if args.action == "path":
        print(BOOKMARKS)


def cmd_style(args):
    if args.value:
        set_key("style", args.value)
    else:
        print(get("style"))


def cmd_keywords(_):
    for key, text in KEYWORDS:
        print(f"  {paint('36', key.ljust(3))} {text}")
    print(paint("2", "  turn prefixes off with: yags feature off keywords"))


def cmd_install(args):
    if not (REPO / "metadata.json").exists():
        die(f"run install from a yags checkout, {REPO} has no metadata.json")
    EXT_DIR.parent.mkdir(parents=True, exist_ok=True)
    if EXT_DIR.is_symlink() or EXT_DIR.is_file():
        EXT_DIR.unlink()
    elif EXT_DIR.exists():
        shutil.rmtree(EXT_DIR)
    if args.link:
        EXT_DIR.symlink_to(REPO)
    else:
        EXT_DIR.mkdir()
        for item in PAYLOAD:
            src = REPO / item
            if src.is_dir():
                shutil.copytree(src, EXT_DIR / item)
            elif src.exists():
                shutil.copy2(src, EXT_DIR / item)
    res = run("glib-compile-schemas", str(EXT_DIR / "schemas"))
    if res is None or res.returncode != 0:
        die("glib-compile-schemas failed")
    ok(f"installed to {EXT_DIR}" + (" (linked)" if args.link else ""))
    BIN_DIR.mkdir(parents=True, exist_ok=True)
    cli = BIN_DIR / "yags"
    if cli.is_symlink() or cli.exists():
        cli.unlink()
    cli.symlink_to(REPO / "bin" / "yags")
    ok(f"cli linked at {cli}")
    if ext_state() in ("ACTIVE", "ENABLED"):
        print("  log out and back in to load the new version")
    else:
        print("  log out and back in, then run: yags enable")


def cmd_uninstall(_):
    run("gnome-extensions", "disable", UUID)
    if EXT_DIR.is_symlink() or EXT_DIR.is_file():
        EXT_DIR.unlink()
    elif EXT_DIR.exists():
        shutil.rmtree(EXT_DIR)
    cli = BIN_DIR / "yags"
    if cli.is_symlink() and cli.resolve() == (REPO / "bin" / "yags").resolve():
        cli.unlink()
    ok("uninstalled, settings kept (yags reset --all before uninstalling to clear them)")


def main():
    p = argparse.ArgumentParser(prog="yags", description="Yet Another GNOME Search, configuration tool.")
    p.add_argument("--version", action="version", version=f"yags {VERSION}")
    sub = p.add_subparsers(dest="cmd", metavar="command")

    sub.add_parser("status", help="show install state and key settings").set_defaults(fn=cmd_status)
    sub.add_parser("enable", help="turn the extension on").set_defaults(fn=cmd_enable)
    sub.add_parser("disable", help="turn the extension off").set_defaults(fn=cmd_disable)
    sub.add_parser("doctor", help="check dependencies and shortcut conflicts").set_defaults(fn=cmd_doctor)
    sub.add_parser("prefs", help="open the preferences window").set_defaults(fn=cmd_prefs)

    s = sub.add_parser("list", aliases=["config"], help="show every setting")
    s.add_argument("--features", action="store_true", help="only feature switches")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("get", help="print one setting")
    s.add_argument("key")
    s.set_defaults(fn=cmd_get)

    s = sub.add_parser("set", help="change one setting")
    s.add_argument("key")
    s.add_argument("value", nargs="+")
    s.set_defaults(fn=cmd_set)

    s = sub.add_parser("reset", help="restore defaults")
    s.add_argument("keys", nargs="*")
    s.add_argument("--all", action="store_true")
    s.set_defaults(fn=cmd_reset)

    s = sub.add_parser("feature", help="list or toggle features")
    s.add_argument("action", nargs="?", choices=["list", "on", "off"])
    s.add_argument("names", nargs="*", help="feature names, or all")
    s.set_defaults(fn=cmd_feature)

    s = sub.add_parser("theme", help="default, dark or light")
    s.add_argument("value", nargs="?", choices=["default", "dark", "light"])
    s.set_defaults(fn=cmd_theme)

    s = sub.add_parser("shortcut", help="show or set the toggle shortcut, e.g. super+space")
    s.add_argument("value", nargs="?")
    s.set_defaults(fn=cmd_shortcut)

    s = sub.add_parser("accent", help="show or set the accent color, e.g. #ff375f")
    s.add_argument("value", nargs="?")
    s.set_defaults(fn=cmd_accent)

    s = sub.add_parser("provider", aliases=["source"], help="list or toggle search sources, e.g. contacts")
    s.add_argument("action", nargs="?", choices=["list", "on", "off"])
    s.add_argument("names", nargs="*")
    s.set_defaults(fn=cmd_provider)

    s = sub.add_parser("bookmark", aliases=["bm"], help="yags bookmarks: list, add NAME TARGET, rm NAME")
    s.add_argument("action", nargs="?", choices=["list", "add", "rm", "remove", "path"])
    s.add_argument("rest", nargs="*")
    s.add_argument("--type", choices=["file", "folder", "site", "location", "command"])
    s.add_argument("--tag", action="append")
    s.set_defaults(fn=cmd_bookmark)

    s = sub.add_parser("style", help="mac (default) or powertoys")
    s.add_argument("value", nargs="?", choices=["mac", "powertoys"])
    s.set_defaults(fn=cmd_style)

    sub.add_parser("keywords", help="list prefix keywords").set_defaults(fn=cmd_keywords)

    s = sub.add_parser("install", help="install this checkout into GNOME Shell")
    s.add_argument("--link", action="store_true", help="symlink instead of copy, for development")
    s.set_defaults(fn=cmd_install)
    sub.add_parser("uninstall", help="remove the extension").set_defaults(fn=cmd_uninstall)

    args = p.parse_args()
    if not args.cmd:
        cmd_status(args)
        print()
        p.print_help()
        return
    args.fn(args)


if __name__ == "__main__":
    main()
